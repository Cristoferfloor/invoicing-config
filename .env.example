CONFIG_PORT=3003

# Base "config" de Infrastructure/ (usuario config)
CONFIG_PG_URL=postgres://config:CLAVE@postgres:5432/config

# Token para todos los endpoints /v1 (header X-Token-Admin)
CONFIG_ADMIN_TOKEN=

# Llave para cifrar los tokens de los ERP: openssl rand -base64 32
# Si se pierde, hay que volver a cargar los tokens.
CONFIG_MASTER_KEY=

# Solo para npm run migration:* desde el equipo (fuera de Docker la base
# esta en 127.0.0.1:5433). Si no se define, se usa CONFIG_PG_URL.
# MIGRATIONS_PG_URL=postgres://config:CLAVE@127.0.0.1:5433/config
